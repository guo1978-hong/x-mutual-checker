{
  "manifest_version": 3,
  "name": "互关检测助手 for X（名单保护版）",
  "version": "1.9.4",
  "description": "整理 X 互关与未回关名单，保护今天或近7天新增关注，管理永久白名单，支持双向排序和可调竖屏面板。非 X 官方产品。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "ui-controls.js",
        "relationship-guards.js",
        "content.js"
      ],
      "css": [
        "content.css",
        "dashboard.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "互关检测助手 for X（点击开启 / 关闭）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "互关检测助手"
}

